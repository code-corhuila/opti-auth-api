# Variables read by the service (see deploy/compose.yml). Copy to .env, which git ignores.
AUTH_DB_NAME=auth
AUTH_DB_USER=auth_owner
AUTH_DB_PASSWORD=<same-password-as-opti-auth-db>
# RSA key pair, PEM on one line with literal \n (see opti-infra/scripts/dev-keys.sh). This is the
# ONLY service that reads the private key: it is who signs the tokens every other service verifies.
JWT_PUBLIC_KEY=<pem-public-key-one-line>
JWT_PRIVATE_KEY=<pem-private-key-one-line>
AUTH_TOKEN_TTL_MINUTES=60

# Optional for the persistence integration test (skipped when empty):
# TEST_DATABASE_URL=jdbc:postgresql://localhost:5432/auth?user=<user>&password=<password>
